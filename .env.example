# ============================================================
# Personal AI Assistant — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Database ---
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# --- OpenAI ---
# Required for AI chat, task extraction, voice transcription
OPENAI_API_KEY=sk-...

# Optional: override default model (gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Application ---
# Flask secret key (required in production — use a long random string)
SECRET_KEY=change-me-to-a-long-random-secret

# Environment: development | production
FLASK_ENV=development

# --- CORS ---
# Comma-separated list of allowed origins (use specific domains in production)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8000

# --- Token lifecycle ---
# Auth token expiry in seconds (default: 86400 = 24 hours)
AUTH_TOKEN_EXPIRY_SECONDS=86400

# --- Rate limiting ---
# Max login attempts per minute per IP (default: 10)
RATE_LIMIT_LOGIN=10
# Max AI requests per minute per user (default: 20)
RATE_LIMIT_AI=20
# Max general API requests per minute per IP (default: 60)
RATE_LIMIT_GENERAL=60

# --- AI budgets ---
# Maximum output tokens per AI chat response (default: 1024)
AI_MAX_TOKENS=1024
# Maximum output tokens for task/intent extraction (default: 512)
AI_MAX_TOKENS_EXTRACTION=512
# Maximum input message length in characters (default: 4000)
AI_MAX_INPUT_CHARS=4000

# --- Voice ---
# Maximum audio upload size in bytes (default: 10485760 = 10 MB)
VOICE_MAX_UPLOAD_BYTES=10485760

# --- Logging ---
# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
