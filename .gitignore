# ============================================================
# Personal AI Assistant — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Secrets and credentials ---
.env
.env.*
!.env.example
secrets.json
secrets.yaml
*.pem
*.key
*.crt

# --- Logs ---
*.log
logs/
log/

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# --- Type checking ---
.mypy_cache/
.dmypy.json

# --- Database / local state ---
*.sqlite
*.sqlite3
*.db

# --- Temporary files ---
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# --- OS artifacts ---
.DS_Store
Thumbs.db
._*

# --- Editor / IDE ---
.vscode/
.idea/
.cursor/
.bob/
*.sublime-project
*.sublime-workspace
